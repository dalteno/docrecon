<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Dalteno.DocRecon</PackageId>
    <Version>1.1.0</Version>
    <Authors>Dalteno</Authors>
    <Description>Deterministic reconciliation of commercial invoice, packing list and bill of lading.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dalteno/docrecon</RepositoryUrl>
  </PropertyGroup>
</Project>
