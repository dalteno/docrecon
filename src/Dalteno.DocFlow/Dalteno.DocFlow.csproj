<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Dalteno.DocFlow</PackageId>
    <Version>1.1.0</Version>
    <Authors>Dalteno</Authors>
    <Description>Deterministic, event-sourced workflow for a shipment document dossier: routing, extraction, reconciliation gate, approval, ERP outbox, notifications, closure.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dalteno/docrecon</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dalteno.DocRecon/Dalteno.DocRecon.csproj" />
  </ItemGroup>
</Project>
